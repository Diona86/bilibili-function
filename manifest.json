{
  "manifest_version": 3,
  "name": "网页视频下载与 B 站笔记",
  "description": "下载网页和嵌入式播放器中的视频，在 B 站按分 P 下载或生成学习笔记。",
  "version": "0.9.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "storage", "offscreen", "activeTab", "downloads", "webRequest", "alarms"],
  "host_permissions": ["https://www.bilibili.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [{
    "resources": ["media/detector.js", "media/probe.js", "media/resource.js", "media/manifests.js", "media/hls.js",
      "media/io.js", "media/runner.js", "media/subtitles.js", "media/verify.js", "media-mp4.js", "web-stream.js",
      "vendor/mediabunny.min.mjs", "vendor/mpd-parser.min.js"],
    "matches": ["https://*/*", "http://*/*"]
  }],
  "action": { "default_title": "打开视频下载与笔记" },
  "side_panel": { "default_path": "sidepanel.html" }
}
